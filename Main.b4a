'Código para Main.b4a
#Region  Project Attributes 
    #ApplicationLabel: Mi App Localhost
    #VersionCode: 1
    #VersionName: 1.0.0
    'SupportedOrientations possible values: unspecified, landscape or portrait.
    #SupportedOrientations: unspecified
    #CanInstallToExternalStorage: False
#End Region

Sub Process_Globals
    Dim Server As HttpServer
End Sub

Sub Globals
    Dim WebView1 As WebView
End Sub

Sub Activity_Create(FirstTime As Boolean)
    If FirstTime Then
        Server.Initialize(8080) 
        Server.Start("Server")
    End If
    
    WebView1.Initialize("WebView1")
    Activity.AddView(WebView1, 0, 0, 100%x, 100%y)
    
    Dim jo As JavaObject = WebView1
    Dim settings As JavaObject = jo.RunMethod("getSettings", Null)
    settings.RunMethod("setJavaScriptEnabled", Array(True))
    settings.RunMethod("setDomStorageEnabled", Array(True))
    settings.RunMethod("setDatabaseEnabled", Array(True))
    settings.RunMethod("setAllowFileAccess", Array(True))
    settings.RunMethod("setAllowContentAccess", Array(True))
    
    WebView1.LoadUrl("http://127.0.0.1:8080/index.html")
End Sub

Sub Server_HandleRequest (Request As ServletRequest, Response As ServletResponse)
    Dim filename As String = Request.RequestURI
    If filename = "/" Or filename = "" Then filename = "index.html"
    If filename.StartsWith("/") Then filename = filename.SubString(1)
    
    If File.Exists(File.DirAssets, filename) Then
        Response.SendFile(File.DirAssets, filename)
    Else
        Response.Status = 404
    End If
End Sub